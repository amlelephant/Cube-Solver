# Copy to .env.local and fill in. .env.local is gitignored.

# --- Waitlist (app/api/waitlist/route.ts) --------------------------------
#
# Where signups go. If unset, the route falls back to appending JSONL to
# WAITLIST_FILE — which is NOT durable on Vercel/Lambda (the filesystem is
# wiped between invocations) and will silently lose signups there. Set this
# before the landing page goes public.
#
# Any endpoint accepting a JSON POST of {email, ts, ref, ipHash} works.
#
#   Buttondown   https://api.buttondown.email/v1/subscribers
#                (needs an Authorization header — use a Zapier/Make webhook
#                 or a tiny proxy, since this route sends no auth header)
#   Loops        https://app.loops.so/api/v1/contacts/create
#   Zapier       https://hooks.zapier.com/hooks/catch/<id>/<hook>/
#   Make         https://hook.eu1.make.com/<hook>
#
# Signups still fall back to the local file if the provider errors, so a
# provider outage costs nothing.
WAITLIST_WEBHOOK_URL=

# Fallback path when the webhook is unset or failing. Defaults to
# ../waitlist.jsonl (repo root), which is gitignored — it holds real email
# addresses and must never be committed.
# WAITLIST_FILE=

# Optional. Without it no IP information is stored at all (the route stores
# nothing rather than a weakly-hashed, trivially-reversible IP). Set it to
# any long random string if you want to spot one source flooding the list.
WAITLIST_IP_SALT=
