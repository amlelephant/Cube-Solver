# Python environment
.venv/
__pycache__/
*.pyc

# Model weights and other ML artifacts — large binaries, not source.
# Regenerate via the training scripts (cv/train.py, cv/cnn_classifier.py --train,
# ble/train_move_classifier.py) rather than committing them.
*.pt
*.pt.bak
*.task
runs/
training_runs/
cv/detection/training_log_*.txt
cv/detection/training_err_*.txt

# Training data and datasets — large, re-collected rather than versioned in git.
cv/detection/face_dataset/
cv/detection/cube_dataset/
cv/detection/merged_dataset/
cv/detection/merged_dataset_mblur/
ble/training_data/

# Precomputed pruning tables for cv/solver/twophase/ (the vendored solver) —
# generated on first solve() call (~1 min), cached to speed up subsequent runs.
tables.json

# QTM pattern-database cache built by ble/move_detector/reconstruct.py
ble/move_detector/reconstruct_tables.npz

# Ad-hoc experiment run logs and measurement result dumps — regenerate by
# re-running the scripts that produced them (see ble/move_detector/*.py
# module docstrings for the invocations); not source.
ble/*.log
ble/*.json
ble/move_detector/*.log
ble/move_detector/*.json
ble/move_detector/scorecards/
ble/move_detector/crop_contact_sheet.png

# Rendered figures from viz_encodings.py / raft_flow_viz.py — regenerate
# from a session, not source.
ble/viz_out/
ble/viz_flow/

# OS
Thumbs.db
.DS_Store
cv/labeling/autolabel_out/
cv/labeling/sessions/
