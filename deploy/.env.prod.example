# Production environment. Copy to the REPO ROOT as .env — compose reads it
# from there, not from this directory:
#
#     cp deploy/.env.prod.example .env
#     chmod 600 .env          # deploy.sh refuses to run if this is wrong
#
# .env is gitignored. It holds the database password and the key that signs
# scrambles; anyone with it can mint valid scrambles and read every row.

# --- site -----------------------------------------------------------------
# Bare hostname, no scheme, no trailing slash. Caddy requests the
# certificate for exactly this, so a typo shows up as "no certificate".
DOMAIN=cubearena.example
# Let's Encrypt sends expiry warnings here. A real inbox you read.
ACME_EMAIL=you@example.com

# --- Django ---------------------------------------------------------------
# REQUIRED. Signs scrambles, so a leak lets anyone mint their own. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Must stay 0. deploy.sh refuses to start with it on: DEBUG disables secure
# cookies, HSTS and the HTTPS redirect, and serves tracebacks containing
# settings to whoever triggers a 500.
DJANGO_DEBUG=0

# Django rejects any request whose Host is not listed, with a 400 that reads
# like a proxy bug. `django` is here because containers reach each other by
# service name, and the healthcheck calls itself.
DJANGO_ALLOWED_HOSTS=cubearena.example,www.cubearena.example,django,127.0.0.1

# WITH the scheme, and https. Without a match here every login and signup
# POST comes back as a bare 403 (see RUNNING.md's gotcha list).
DJANGO_CSRF_TRUSTED_ORIGINS=https://cubearena.example,https://www.cubearena.example

# How a recipient actually reaches the site — used to build unsubscribe
# links, so an internal hostname produces links nobody can open.
SITE_URL=https://cubearena.example

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=cubearena
POSTGRES_USER=cubearena
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never reachable from outside the compose network, but a weak password here
# means one container compromise is total.
POSTGRES_PASSWORD=

# Roughly (2 x cores) + 1. Four workers suits the 2-vCPU VM in DEPLOY.md.
GUNICORN_WORKERS=4

# --- admin access ---------------------------------------------------------
# Who may reach /api/admin/ at all. Caddy answers 404 to everyone else, so
# the admin does not even appear to exist — which stops the credential
# stuffing before it reaches a login form.
#
# Set this to your own address as soon as you know it:
#   curl -s https://ifconfig.me         ->  e.g. 203.0.113.44/32
# A home connection whose address changes: use the /24, or a VPN's exit
# address, or keep 0.0.0.0/0 and rely on a long unique admin password.
# Space-separated for more than one.
ADMIN_ALLOW_CIDR=0.0.0.0/0

# --- backups --------------------------------------------------------------
BACKUP_KEEP_DAYS=14

# --- email ----------------------------------------------------------------
# A TRANSACTIONAL RELAY, not a self-hosted SMTP server. Mail from an unknown
# IP mostly lands in spam; SPF, DKIM and DMARC alignment plus the relay's IP
# reputation are what get verification mail delivered at all.
#
# LEAVING THIS EMPTY IS NOT NEUTRAL IN PRODUCTION: with no EMAIL_HOST, mail
# is printed to the container log, and since ACCOUNT_EMAIL_VERIFICATION is
# mandatory, nobody can finish signing up. Set it before launch.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=CubeArena <hello@cubearena.example>

# --- privacy --------------------------------------------------------------
# Salt for hashing waitlist signup IPs. EMPTY MEANS STORE NOTHING, which is
# the deliberate default — an unsalted hash of an IP is not anonymisation,
# the space is small enough to enumerate in seconds. Set it only if you
# actually need abuse investigation, and treat it as a secret.
WAITLIST_IP_SALT=
