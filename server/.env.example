# Copy to ../.env (repo root — docker compose reads it from there).

# --- Django ---------------------------------------------------------------
# REQUIRED in production. Signs scrambles; Django refuses to start without it
# when DJANGO_DEBUG is off. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
# Must include the scheme, and must match how the browser reaches Caddy.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# How recipients actually reach the site. Used to build unsubscribe links,
# so an internal hostname here produces links nobody can open.
SITE_URL=http://localhost:8080

# --- Postgres -------------------------------------------------------------
# REQUIRED. The SQLite fallback only applies with DJANGO_DEBUG=1 and exists
# so `manage.py test` runs with no services up.
POSTGRES_DB=cubearena
POSTGRES_USER=cubearena
POSTGRES_PASSWORD=
# Set by compose; only needed here if running Django outside Docker.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

GUNICORN_WORKERS=3

# --- Email ----------------------------------------------------------------
# The waitlist is the `WaitlistSignup` table and `manage.py send_waitlist`
# mails it. There is no list-management SaaS in the loop.
#
# Point this at a TRANSACTIONAL RELAY (Postmark, SES, SendGrid, Mailgun) —
# NOT a self-hosted SMTP server. The table stays the source of truth; the
# relay only carries the message. This matters because bulk mail from an
# unknown IP largely lands in spam, and SPF/DKIM/DMARC alignment plus IP
# reputation are what fix that. Leaving EMAIL_HOST unset prints mail to the
# console, which is what dry-run development wants.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=CubeArena <hello@example.com>

# --- Optional -------------------------------------------------------------
# Without this NO IP information is stored at all, which is the deliberate
# default: an unsalted hash of an IP is not anonymisation.
WAITLIST_IP_SALT=
